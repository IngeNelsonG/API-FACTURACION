# Configuración de la API de Facturación DIAN - Grupo 5
# Copie este archivo a .env y reemplace los valores de ejemplo (NUNCA subir .env real a Git)

# Clave secreta para firmar los tokens JWT (en Render se genera automáticamente)
SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria

# Base de datos local (SQLite). Se ignora si se define DATABASE_URL.
DB_NAME=facturacion.db

# Base de datos persistente en la nube (PostgreSQL, p. ej. Render PostgreSQL o Neon)
# Si se deja vacío, la API usa SQLite local automáticamente.
DATABASE_URL=

# Orígenes permitidos por CORS separados por coma (URL del frontend en producción)
# Si se deja vacío, permite localhost/127.0.0.1/red local en desarrollo.
CORS_ORIGINS=

# Envío de correos por HTTPS (recomendado en Render Free Tier, donde SMTP 587 está bloqueado)
RESEND_API_KEY=
RESEND_FROM=Facturación DIAN <onboarding@resend.dev>

# Configuración alternativa de Gmail SMTP para ejecución local o servidores con SMTP abierto
# (Dejar en blanco para modo simulado en pruebas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
