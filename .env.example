# Copie este archivo a .env y ajuste los valores. NUNCA versione .env.
# Referencia completa: docs/development/configuracion.md

ENTORNO=desarrollo            # desarrollo | pruebas | produccion
DATABASE_URL=sqlite:///./var/facturacion.db
# DATABASE_URL=postgresql+psycopg://facturacion:CAMBIAR@localhost:5432/facturacion
URL_PUBLICA_BASE=http://localhost:8000
CORS_ORIGENES=                # lista separada por comas, p. ej. https://app.midominio.co

# --- JWT (genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRETO=CAMBIAR-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_MINUTOS_EXPIRACION=30
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=300
REGISTRO_PUBLICO=false

# --- DIAN (descomente al pasar a DIAN_MODO=habilitacion) ---
DIAN_MODO=simulado            # simulado | habilitacion  (producción no soportada)
DIAN_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
# DIAN_SOFTWARE_ID=             # Portal de habilitación -> Software propio
# DIAN_PIN=                     # PIN que usted registró para el software
# DIAN_TEST_SET_ID=             # TestSetId del set de pruebas (vaciar al terminar el set)
# DIAN_CERTIFICADO_RUTA=certificados/certificado.p12
# DIAN_CERTIFICADO_CLAVE=

# --- Emisor: debe coincidir EXACTAMENTE con el RUT ---
EMISOR_NIT=900000000
EMISOR_DV=0
EMISOR_RAZON_SOCIAL=EMPRESA DE PRUEBAS S.A.S.
EMISOR_NOMBRE_COMERCIAL=EMPRESA DE PRUEBAS
EMISOR_TIPO_ORGANIZACION=1    # 1 persona jurídica, 2 persona natural
EMISOR_RESPONSABILIDADES=R-99-PN
EMISOR_DIRECCION="CALLE 1 # 1-1"
EMISOR_CIUDAD=Bogotá, D.C.
EMISOR_CODIGO_MUNICIPIO=11001
EMISOR_DEPARTAMENTO=Bogotá
EMISOR_CODIGO_DEPARTAMENTO=11
EMISOR_EMAIL=facturacion@example.com
EMISOR_TELEFONO=6010000000

# --- Numeración de pruebas (la asigna la DIAN al habilitar el software) ---
NUMERACION_PREFIJO=SETP
NUMERACION_DESDE=990000000
NUMERACION_HASTA=995000000
NUMERACION_RESOLUCION=18760000001
NUMERACION_FECHA_DESDE=2019-01-19
NUMERACION_FECHA_HASTA=2030-01-19
# NUMERACION_CLAVE_TECNICA=

# --- Proveedor tecnológico (Factus) ---
FACTURACION_MODO=directo      # directo (DIAN/simulado) | factus
FACTUS_URL=https://api-sandbox.factus.com.co
# FACTUS_CLIENT_ID=
# FACTUS_CLIENT_SECRET=
# FACTUS_USUARIO=
# FACTUS_CLAVE=
# FACTUS_RANGO_NUMERACION_ID=  # id del rango en Factus (opcional)

# --- Correo ---
CORREO_MODO=simulado          # simulado (escribe .eml en var/correos) | smtp
CORREO_REMITENTE=facturacion@example.com
SMTP_HOST=smtp.example.com
SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- QR: "propia" apunta a /api/v1/verificacion/{cufe}; "dian" al catálogo de habilitación ---
QR_URL_MODO=propia
